{
  "extends": [
    "config:base",
    "group:allNonMajor",
    ":semanticCommits"
  ],
  "baseBranches": [
    "main"
  ],
  "labels": [
    "enhancement"
  ],
  "reviewers": [
    "xymb-endcrystalme"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "matchPackageNames": [
        "**"
      ],
      "allowedVersions": "!/\\-SNAPSHOT$/"
    },
    {
      "description": "Fabric API must target the Minecraft version supported by the client.",
      "matchPackageNames": [
        "net.fabricmc.fabric-api:fabric-api"
      ],
      "allowedVersions": "/\\+26\\.2$/"
    }
  ]
}
